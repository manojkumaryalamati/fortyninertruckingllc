{
  "hosting": {
    "public": "artifacts/forty-niner/dist/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": "BASE_PATH=/ pnpm --filter @workspace/forty-niner run build",
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
